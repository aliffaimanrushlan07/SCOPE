# =====================================================================
# SCOPE backend configuration
# Copy to .env and fill in the real values. Never commit .env.
# =====================================================================

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://scope:scope_dev_password@localhost:5432/scope

# --- Admin session (FR08, D01 component 7: 30-minute inactivity timeout) ---
JWT_SECRET=replace_me__generate_with__openssl_rand_hex_32
JWT_EXPIRY_MINUTES=30

# --- AI classification module ---
# AI_CONFIDENCE_THRESHOLD is the server-side configurable value required by
# SCOPE-System-Flow-Revised.md section S10. It is read at request time, so a
# change here takes effect on restart without rebuilding the mobile app.
#
# Chosen from model evaluation, not picked in advance — see ml/README.md.
# Deliberately NOT the best-F1 point (0.33): a report passes when any ONE of
# up to three photographs clears the threshold, so a false positive gets three
# chances per report while a false negative needs all three to fail. At 0.70
# an invalid report is accepted 5.8% of the time instead of 13.3%, and 0.70 is
# where the false-positive rate plateaus rather than a point on a cliff edge.
AI_CONFIDENCE_THRESHOLD=0.70
AI_MODEL_VERSION=vit-scope-v1
AI_MODEL_PATH=../ml/artifacts/vit-scope-v1.keras
AI_STUB_MODE=false
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Google Maps Platform ---
# Server key only: used for Places Autocomplete (S11 search) and Geocoding
# (S11 address readout), proxied through the backend so the key never ships
# inside the APK. Restrict this key by IP address.
SERVER_MAPS_KEY=replace_me

# --- Storage ---
UPLOAD_DIR=./uploads

# --- Abuse controls (section S14: replaces account-level deterrence) ---
RATE_LIMIT_PER_DEVICE_PER_HOUR=5

# --- CORS: the React dashboard origin ---
DASHBOARD_ORIGIN=http://localhost:5173
