# =====================================================================
# SCOPE backend configuration
# Copy to .env and fill in the real values. Never commit .env.
# =====================================================================

# --- Database (matches infra/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://scope:scope_dev_password@localhost:5432/scope

# --- Admin session (FR08, D01 component 7: 30-minute inactivity timeout) ---
JWT_SECRET=replace_me__generate_with__openssl_rand_hex_32
JWT_EXPIRY_MINUTES=30

# --- AI classification module ---
# AI_CONFIDENCE_THRESHOLD is the server-side configurable value required by
# SCOPE-System-Flow-Revised.md section S10. It is read at request time, so a
# change here takes effect on restart without rebuilding the mobile app.
#
# Chosen from model evaluation, not picked in advance — see ml/README.md.
# Deliberately NOT the best-F1 point: a report passes when any ONE of up to
# three photographs clears the threshold, so a false positive gets three
# chances per report while a false negative needs all three to fail.
# 0.90 is a deliberate strictness policy, set above the 0.71 the validation
# rule gives: only clear photographs of a lit cigarette should pass, and
# hard negatives (pens, chopsticks) must not. On test (vit-scope-v3) it gives
# precision 1.000, recall 0.747 and 0 of 22 hard negatives accepted, at the
# cost of about 1 in 4 genuine photographs needing a retake.
AI_CONFIDENCE_THRESHOLD=0.90
AI_MODEL_VERSION=vit-scope-v3
AI_MODEL_PATH=../ml/artifacts/vit-scope-v3.keras
# Variance-of-Laplacian sharpness at a 512 px long side; photographs below it
# fail as "Image too blurry" whatever they score. 20 rejects no genuine
# validation photograph and catches 97% of artificially blurred copies.
# 0 disables the check.
AI_MIN_SHARPNESS=20
AI_STUB_MODE=false
AI_REQUEST_TIMEOUT_SECONDS=30

# --- Google Maps Platform ---
# Server key only: used for Places Autocomplete (S11 search) and Geocoding
# (S11 address readout), proxied through the backend so the key never ships
# inside the APK. Restrict this key by IP address.
SERVER_MAPS_KEY=replace_me

# --- Storage ---
UPLOAD_DIR=./uploads

# --- Abuse controls (section S14: replaces account-level deterrence) ---
RATE_LIMIT_PER_DEVICE_PER_HOUR=5

# --- CORS: the React dashboard origin ---
DASHBOARD_ORIGIN=http://localhost:5173
